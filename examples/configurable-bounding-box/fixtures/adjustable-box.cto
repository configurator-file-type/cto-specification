{
  "cto_version": "0.3.0",
  "cto_type": "element",
  "element_meta": {
    "id": "example-adjustable-box",
    "name": "Adjustable box — abstract visualization fixture",
    "category": "wall_panel",
    "product_version": "0.1.0",
    "status": "draft",
    "created_at": "2026-11-14T05:49:33Z",
    "modified_at": "2026-11-14T05:49:33Z",
    "manufacturer": {
      "name": "Example fixture author — fictional, not a manufacturer",
      "website": "https://example.com",
      "contact": {
        "name": "Example fixture author",
        "email": "fixture@example.com",
        "role": "synthetic example maintainer"
      }
    },
    "description": "An abstract box used only to demonstrate the pinned experimental CTO parameter contract. No house, framing, material, actual product or manufacturer is represented.",
    "notes": "wall_panel is an existing schema carrier, not a claim that this box is a wall product. Limits are invented test values, not engineering or manufacturer approvals. Source-local feet: X width, Y height, Z depth."
  },
  "declares_interface": [],
  "catalog_reference": {
    "manufacturer": "Example fixture author — fictional, not a manufacturer",
    "manufacturer_website": "https://example.com",
    "catalog_id": "example-box-visualization-fixtures",
    "catalog_edition": "Non-normative visualization fixtures",
    "catalog_version": "0.1.0",
    "interface_standards": []
  },
  "parameters": {
    "description": "Three source-declared dimensions drive literal current extents. The reference box is 8 ft wide, 6 ft high and 2 ft deep; the declared range is not stored inside bounding_box.",
    "label_template": "Abstract box — {width_ft} × {height_ft} × {depth_ft} ft",
    "inputs": [
      {
        "name": "width_ft",
        "label": "X · width",
        "unit": "ft",
        "min": 1,
        "max": 12,
        "default": 8,
        "adjustment": "continuous",
        "description": "Product-local positive X. Any finite width inside these invented visualization bounds."
      },
      {
        "name": "height_ft",
        "label": "Y · height",
        "unit": "ft",
        "min": 1,
        "max": 10,
        "default": 6,
        "adjustment": "stepped",
        "step": 0.5,
        "description": "Product-local positive Y. Half-foot steps measured from the 1 ft minimum; invented visualization bounds."
      },
      {
        "name": "depth_ft",
        "label": "Z · depth",
        "unit": "ft",
        "min": 0.25,
        "max": 4,
        "default": 2,
        "adjustment": "stepped",
        "step": 0.25,
        "description": "Product-local positive Z. Quarter-foot steps measured from the 0.25 ft minimum; invented visualization bounds."
      }
    ],
    "constants": {},
    "derived": [],
    "rules": [],
    "bindings": [
      {
        "target": "/geometry/nominal_dimensions/width_ft",
        "expr": "width_ft"
      },
      {
        "target": "/geometry/nominal_dimensions/length_ft",
        "expr": "depth_ft"
      },
      {
        "target": "/geometry/bounding_box/width_ft",
        "expr": "width_ft"
      },
      {
        "target": "/geometry/bounding_box/height_ft",
        "expr": "height_ft"
      },
      {
        "target": "/geometry/bounding_box/length_ft",
        "expr": "depth_ft"
      },
      {
        "target": "/geometry/bounding_box/max/x",
        "expr": "width_ft"
      },
      {
        "target": "/geometry/bounding_box/max/y",
        "expr": "height_ft"
      },
      {
        "target": "/geometry/bounding_box/max/z",
        "expr": "depth_ft"
      }
    ]
  },
  "geometry": {
    "nominal_dimensions": {
      "width_ft": 8,
      "length_ft": 2,
      "description": "Current X/Z footprint in feet; follows width and depth without changing the origin."
    },
    "bounding_box": {
      "width_ft": 8,
      "length_ft": 2,
      "height_ft": 6,
      "weight_lbs": null,
      "min": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "max": {
        "x": 8,
        "y": 6,
        "z": 2
      },
      "description": "Literal current extents at the reference inputs, in product-local feet: X width, Y height, Z depth. This is an abstract visualization envelope, not a physical shipping claim."
    },
    "chase_zones": [],
    "opening_geometry": null,
    "clearance_zones": [],
    "model_glb_url": null
  },
  "connectivity": {
    "interface_roles": [],
    "connection_points": []
  },
  "constraints": {
    "permitted_orientation": "vertical"
  }
}
